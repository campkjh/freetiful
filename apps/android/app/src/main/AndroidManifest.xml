<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 🔔 Android 13 알림 권한 추가 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ✅ 기존 권한 유지 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 📍 채팅 '현재 위치 보내기'(웹 navigator.geolocation) — 앱을 쓰는 동안만. 백그라운드 위치는 받지 않는다
         (261012 사장 '채팅창 내에서 갤럭시 장소/음성 전달 실패' — 2.0.6 은 위치 권한이 없어 위치 받기가 늘 실패) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Freetiful"
        tools:targetApi="33">

    <!-- 🔥 카카오 네이티브 앱 키 등록 -->
    <meta-data
        android:name="com.kakao.sdk.AppKey"
        android:value="c0c3d8d54694eea9e142783494004639" />

    <!-- 🔥 카카오 로그인 리디렉트 처리 Activity -->
    <activity
        android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data
                android:scheme="kakaoc0c3d8d54694eea9e142783494004639"
                android:host="oauth" />
        </intent-filter>
    </activity>

    <!-- ✅ 스플래시 화면 -->
    <activity
        android:name=".SplashActivity"
        android:exported="true"
        android:theme="@style/Theme.Freetiful.Launcher"
        android:windowSoftInputMode="adjustResize">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

    <!-- ✅ 메인 화면
         configChanges(261018): 폰을 돌리거나 다크모드·분할 화면으로 바뀌어도 화면(Activity)·웹뷰를 새로 만들지 않는다 — 웹은 resize 만 받는다.
         없으면 회전할 때마다 새 웹뷰가 홈(/main)을 열어 웨딩런(가로 게임)에서 돌리자마자 홈으로 튕겼다 -->
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:theme="@style/Theme.Freetiful"
        android:launchMode="singleTop"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
        android:windowSoftInputMode="adjustResize">
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="freetiful" />
        </intent-filter>
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="freetiful.com" />
            <data android:scheme="https" android:host="www.freetiful.com" />
        </intent-filter>
    </activity>

</application>

    </manifest>
