PORT=4000
DATABASE_URL=postgresql://prettyful:prettyful_dev@localhost:5432/prettyful
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Social Auth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3000/auth/naver/callback

# Naver Local Search (웨딩 파트너 시드용). 비워두면 NAVER_CLIENT_ID/SECRET를 사용합니다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NAVER_BUSINESS_DISPLAY=5

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET=prettyful-media
CLOUDFRONT_DOMAIN=

# AI (Anthropic)
ANTHROPIC_API_KEY=

# Payments
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# External APIs
NICE_API_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# FCM Push
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# OneSignal Push (iOS native)
ONESIGNAL_APP_ID=fcf1313b-36ee-40ab-8fbc-4da8727ae83f
ONESIGNAL_REST_API_KEY=

# Web Push (VAPID) — generate via `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@freetiful.com

# Kakao BizTalk / SOLAPI AlimTalk
BIZTALK_ENABLED=false
BIZTALK_API_KEY=
BIZTALK_API_SECRET=
BIZTALK_PF_ID=@freetiful
BIZTALK_FROM=
BIZTALK_ADMIN_PHONES=
BIZTALK_DISABLE_SMS=true
# Screenshot template-code defaults can be overridden if the provider requires internal template IDs.
BIZTALK_TEMPLATE_GENERAL_SIGNUP_COMPLETE=A0001
BIZTALK_TEMPLATE_GENERAL_SMS_AUTH=A0011
BIZTALK_TEMPLATE_GENERAL_BOOKING_COMPLETE=A0010
BIZTALK_TEMPLATE_GENERAL_NEW_MESSAGE=A0009
BIZTALK_TEMPLATE_CUSTOMER_INQUIRY_ARRIVED=A0003
BIZTALK_TEMPLATE_PARTNER_APPROVED=A0002
BIZTALK_TEMPLATE_PARTNER_NEW_MESSAGE=A00051
BIZTALK_TEMPLATE_PARTNER_MATCH_CONFIRM=A00081
BIZTALK_TEMPLATE_PARTNER_EVENT_COMPLETED=A0007
BIZTALK_TEMPLATE_PARTNER_UPCOMING_EVENT_REMINDER=A0006
BIZTALK_TEMPLATE_PARTNER_QUOTE_REMINDER=A0004

# Platform Config
PLATFORM_FEE_RATE=0.15
MIN_QUOTE_AMOUNT=300000
MEDIA_EXPIRY_DAYS=20
ESCROW_RELEASE_DAYS=3
